# ---- runtime ----
APP_PORT=8080
WEB_PORT=8080
LOG_LEVEL=info

# ---- database (MySQL 8) ----
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=replace-with-a-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
SEED_PASSWORD=Campus@2026

# ---- auth ----
# JWT_SECRET must be at least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=86400

# ---- uploads ----
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80
