# ---- runtime ----
APP_PORT=8080
WEB_PORT=8080
LOG_LEVEL=info

# ---- database (MySQL 8) ----
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=replace-with-a-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
SEED_PASSWORD=Campus@2026

# ---- auth ----
# JWT_SECRET must be at least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=86400

# ---- uploads ----
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80

# ---- vector store ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw_chunks
SEARCH_VECTOR_MIN=0.35
SEARCH_MAX_RESULTS=20
RRF_K=60

# ---- model gateway (OpenAI-compatible) ----
# Leave CHAT_API_KEY empty to use the deterministic offline demo provider.
CHAT_BASE_URL=https://ai-gateway.devops.hello1023.com
CHAT_API_KEY=
CHAT_MODEL=campus-chat
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=campus-embedding
EMBEDDING_DIM=256

# ---- self-hosted MCP tool server ----
# The same value must be used by the api container (host side) and mcp-demo.
MCP_AUTH_TOKEN=replace-with-a-long-random-mcp-token
MCP_PORT=8090
# Upper bound for deterministic tool calls in one turn (no model-driven loop).
MAX_TOOL_CALLS_PER_REQUEST=8
